{
    'QualityFormats': {'Very Low (Lossy)': 'LOW', 'Low (Lossy)': 'HIGH', 'Normal (Lossless 16-bit)': 'LOSSLESS', 'Hi-Res (Lossless 24-bit)': 'HI_RES_LOSSLESS'},
